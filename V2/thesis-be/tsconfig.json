{
  "compilerOptions": {
    /* === Output Settings === */
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "dist",
    /* === Type Checking === */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    /* === Source Maps === */
    "sourceMap": true,
    /* === Module Resolution === */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    /* === Node Environment === */
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/.prisma"
    ]
  },
  "include": [
    "src",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}